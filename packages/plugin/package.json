{
  "name": "vite-plugin-static-magic-link",
  "version": "0.1.0",
  "description": "Encrypt a static Vite site so it only runs for people with the link.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite-plugin",
    "encryption",
    "magic-link",
    "static-site"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc",
    "prepack": "npm run build && cp ../../README.md ../../LICENSE ."
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "tsup": "^9.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
